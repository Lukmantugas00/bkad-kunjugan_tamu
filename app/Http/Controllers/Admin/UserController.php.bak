<?php

namespace App\Http\Controllers\Admin;

use App\Helpers\ActivityLogger;
use App\Http\Controllers\Controller;
use App\Models\Bidang;
use App\Models\User;
use Illuminate\Http\Request;
use Illuminate\Support\Str;
use Illuminate\Support\Facades\Hash;
use Illuminate\Support\Facades\DB;
use Illuminate\Validation\Rule;

class UserController extends Controller
{
    /**
     * Menampilkan daftar akun.
     */
    public function index(Request $request)
    {
        $query = User::with('bidang')
            ->orderBy('name');

        /*
         * Pencarian: NIP, Nama, Role
         */
        if ($request->filled('search')) {
            $search = $request->search;
            $query->where(function ($q) use ($search) {
                $q->where('nip', 'like', "%{$search}%")
                    ->orWhere('name', 'like', "%{$search}%")
                    ->orWhere('role', 'like', "%{$search}%");
            });
        }

        /*
         * Filter Role
         */
        if ($request->filled('role')) {
            $query->where('role', $request->role);
        }

        /*
         * Filter Bidang
         */
        if ($request->filled('bidang_id')) {
            $query->where('bidang_id', $request->bidang_id);
        }

        /*
         * Pagination dengan preserve query string
         */
        $users = $query->paginate(15)->onEachSide(1)->withQueryString();

        /*
         * Bidang untuk dropdown filter
         */
        $bidangs = Bidang::where('aktif', true)
            ->orderBy('nama')
            ->get();

        return view(
            'admin.users.index',
            compact('users', 'bidangs')
        );
    }

    /**
     * Form tambah akun.
     */
    public function create()
    {
        $bidangs = Bidang::where('aktif', true)
            ->orderBy('nama')
            ->get();

        return view(
            'admin.users.create',
            compact('bidangs')
        );
    }

    /**
     * Menyimpan akun baru.
     */
    public function store(Request $request)
    {
        $validated = $request->validate([
            'nip' => [
                'required',
                'string',
                'max:18',
                'unique:users,nip',
            ],

            'name' => [
                'required',
                'string',
                'max:255',
            ],

            'role' => [
                'required',
                Rule::in([
                    'admin',
                    'petugas_piket',
                    'penerima_bidang',
                    'pimpinan',
                ]),
            ],

            'bidang_id' => [
                'nullable',
                'exists:bidangs,id',
                'required_if:role,penerima_bidang',
            ],

            'password' => [
                'required',
                'string',
                'min:6',
                'confirmed',
            ],

            'aktif' => [
                'required',
                'boolean',
            ],
        ]);

        /*
         * Hanya Penerima Bidang yang memiliki bidang.
         */
        if ($validated['role'] !== 'penerima_bidang') {
            $validated['bidang_id'] = null;
        }

        /*
         * Simpan akun baru.
         */
        $user = User::create($validated);

        /*
         * Catat aktivitas Admin.
         */
        ActivityLogger::log(
            'Tambah Akun',
            'Admin menambahkan akun '.
            $user->name.
            ' dengan NIP '.
            $user->nip.
            ' dan role '.
            $user->role.
            '.'
        );

        return redirect()
            ->route('admin.users.index')
            ->with(
                'success',
                'Akun berhasil ditambahkan.'
            );
    }

    /**
     * Form edit akun.
     */
    public function edit(User $user)
    {
        $bidangs = Bidang::where('aktif', true)
            ->orderBy('nama')
            ->get();

        return view(
            'admin.users.edit',
            compact('user', 'bidangs')
        );
    }

    /**
     * Memperbarui akun.
     */
    public function update(
        Request $request,
        User $user
    ) {
        $validated = $request->validate([
            'nip' => [
                'required',
                'string',
                'max:18',
                Rule::unique('users', 'nip')
                    ->ignore($user->id),
            ],

            'name' => [
                'required',
                'string',
                'max:255',
            ],

            'role' => [
                'required',
                Rule::in([
                    'admin',
                    'petugas_piket',
                    'penerima_bidang',
                    'pimpinan',
                ]),
            ],

            'bidang_id' => [
                'nullable',
                'exists:bidangs,id',
                'required_if:role,penerima_bidang',
            ],

            'password' => [
                'nullable',
                'string',
                'min:6',
                'confirmed',
            ],

            'aktif' => [
                'required',
                'boolean',
            ],
        ]);

        /*
         * Selain Penerima Bidang,
         * bidang harus dikosongkan.
         */
        if ($validated['role'] !== 'penerima_bidang') {
            $validated['bidang_id'] = null;
        }

        /*
         * Jika password kosong,
         * password lama tetap digunakan.
         */
        if (empty($validated['password'])) {
            unset($validated['password']);
        }

        $user->update($validated);

        /*
         * Catat aktivitas Admin.
         */
        ActivityLogger::log(
            'Ubah Akun',
            'Admin mengubah akun '.
            $user->name.
            ' dengan NIP '.
            $user->nip.
            '.'
        );

        return redirect()
            ->route('admin.users.index')
            ->with(
                'success',
                'Akun berhasil diperbarui.'
            );
    }

    /**
     * Mengaktifkan / menonaktifkan akun.
     */
    public function toggleAktif(User $user)
    {
        /*
         * Jangan sampai Admin menonaktifkan
         * akun yang sedang digunakan sendiri.
         */
        if ($user->id === auth()->id()) {
            return redirect()
                ->route('admin.users.index')
                ->with(
                    'error',
                    'Akun yang sedang digunakan tidak dapat dinonaktifkan.'
                );
        }

        $user->update([
            'aktif' => ! $user->aktif,
        ]);

        $status = $user->aktif
            ? 'diaktifkan'
            : 'dinonaktifkan';

        /*
         * Catat aktivitas Admin.
         */
        ActivityLogger::log(
            $user->aktif
                ? 'Aktifkan Akun'
                : 'Nonaktifkan Akun',
            'Admin mengubah status akun '.
            $user->name.
            ' menjadi '.
            $status.
            '.'
        );

        return redirect()
            ->route('admin.users.index')
            ->with(
                'success',
                "Akun {$user->name} berhasil {$status}."
            );
    }

    /**
     * Menghapus akun secara permanen.
     */
    public function destroy(User $user)
    {
        /*
         * Jangan sampai Admin menghapus
         * akun yang sedang digunakan sendiri.
         */
        if ($user->id === auth()->id()) {
            return redirect()
                ->route('admin.users.index')
                ->with(
                    'error',
                    'Akun yang sedang digunakan tidak dapat dihapus.'
                );
        }

        /*
         * Cegah penghapusan Admin terakhir yang masih aktif.
         */
        if ($user->role === 'admin' && $user->aktif) {
            $activeAdminCount = User::where('role', 'admin')
                ->where('aktif', true)
                ->count();

            if ($activeAdminCount <= 1) {
                return redirect()
                    ->route('admin.users.index')
                    ->with(
                        'error',
                        'Tidak dapat menghapus Admin terakhir yang masih aktif. Setidaknya satu Admin aktif harus tersisa.'
                    );
            }
        }

        /*
         * Simpan identitas untuk log sebelum dihapus.
         */
        $deletedUserName = $user->name;
        $deletedUserNip = $user->nip;
        $deletedUserRole = $user->role;

        /*
         * Hapus akun.
         * Activity logs akan mempertahankan record dengan user_id = NULL
         * karena foreign key menggunakan nullOnDelete().
         */
        $user->delete();

        /*
         * Catat aktivitas Admin.
         */
        ActivityLogger::log(
            'Hapus Akun',
            'Admin menghapus akun '.
            $deletedUserName.
            ' dengan NIP '.
            $deletedUserNip.
            ' dan role '.
            $deletedUserRole.
            '.'
        );

        return redirect()
            ->route('admin.users.index')
            ->with(
                'success',
                "Akun {$deletedUserName} berhasil dihapus permanen."
            );
    }

    /**
     * Reset password akun oleh Admin.
     */
    public function resetPassword(Request $request, User $user)
    {
        // Jangan sampai Admin mereset password akun yang sedang digunakan sendiri.
        if ($user->id === auth()->id()) {
            return redirect()
                ->route('admin.users.index')
                ->with(
                    'error',
                    'Akun yang sedang digunakan tidak dapat direset passwordnya.'
                );
        }

        // Generate password sementara acak 10 karakter tanpa simbol.
        $tempPassword = Str::random(10);

        // Update password dan set flag must_change_password.
        $user->update([
            'password' => Hash::make($tempPassword),
            'must_change_password' => true,
        ]);

        // Hapus sesi lain milik user ini jika menggunakan session driver database.
        DB::table('sessions')->where('user_id', $user->id)->delete();

        // Catat aktivitas Admin.
        ActivityLogger::log(
            'Reset Password',
            'Admin mereset password akun '.
            $user->name.
            ' (NIP '.
            $user->nip.
            ')'
        );

        // Flash password sementara untuk ditampilkan sekali.
        return redirect()
            ->route('admin.users.index')
            ->with(
                'success',
                'Password berhasil direset.'
            )
            ->with('temp_password', $tempPassword)
            ->with('temp_user_name', $user->name)
            ->with('temp_user_nip', $user->nip);
    }
}
