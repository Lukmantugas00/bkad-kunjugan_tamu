Route::put(
        '/admin/users/{user}/reset-password',
        [UserController::class, 'resetPassword']
    )->name('admin.users.reset_password')
      ->middleware([
          'auth',
          'role:admin',
          'throttle:10,1',
      ]);


use App\Http\Controllers\Admin\ActivityLogController;
use App\Http\Controllers\Admin\BidangController;
use App\Http\Controllers\Admin\DashboardController;
use App\Http\Controllers\Admin\KunjunganController as AdminKunjunganController;
use App\Http\Controllers\Admin\LaporanController;
use App\Http\Controllers\Admin\UserController;
use App\Http\Controllers\Auth\LoginController;
use App\Http\Controllers\KunjunganController;
use App\Http\Controllers\PengaturanBidangController;
use App\Http\Controllers\PimpinanController;
use App\Models\Bidang;
use Illuminate\Support\Facades\Route;

// =========================
// LOGIN
// =========================

Route::get('/login', function () {
    return view('auth.login');
})->name('login');

Route::post('/login', [LoginController::class, 'login'])
    ->name('login.process');

Route::post('/logout', [LoginController::class, 'logout'])
    ->middleware('auth')
    ->name('logout');

// =========================
// HALAMAN UTAMA
// =========================

Route::get('/', function () {
    $bidangs = Bidang::where('aktif', true)
        ->orderBy('nama')
        ->get();

    return view('home', compact('bidangs'));
})->middleware('auth');

// =========================
// PETUGAS PIKET
// =========================

Route::middleware([
    'auth',
    'role:petugas_piket',
])->group(function () {

    Route::get(
        '/kunjungan/create',
        [KunjunganController::class, 'create']
    )->name('kunjungan.create');

    Route::post(
        '/kunjungan',
        [KunjunganController::class, 'store']
    )->name('kunjungan.store');

    Route::get(
        '/kunjungan/status-hari-ini',
        [KunjunganController::class, 'statusHariIni']
    )->name('kunjungan.statusHariIni');

});

// =========================
// PENERIMA BIDANG
// =========================

Route::middleware([
    'auth',
    'role:penerima_bidang',
])->group(function () {

    Route::get(
        '/kotak-masuk/{kode}',
        [KunjunganController::class, 'inbox']
    )->name('kunjungan.inbox');

    Route::post(
        '/kunjungan/{kunjungan}/terima',
        [KunjunganController::class, 'terima']
    )->name('kunjungan.terima');

    Route::post(
        '/kunjungan/{kunjungan}/selesai',
        [KunjunganController::class, 'selesai']
    )->name('kunjungan.selesai');

    Route::get(
        '/notifikasi/kunjungan-baru',
        [KunjunganController::class, 'jumlahNotifikasiBaru']
    )->name('kunjungan.notifikasi-baru');

    Route::get(
        '/pengaturan-bidang/notifikasi',
        [PengaturanBidangController::class, 'edit']
    )->name('pengaturan-bidang.notifikasi');

    Route::put(
        '/pengaturan-bidang/notifikasi',
        [PengaturanBidangController::class, 'update']
    )->name('pengaturan-bidang.notifikasi.update');

});

// =========================
// DETAIL KUNJUNGAN
// =========================

Route::get(
    '/kunjungan/{kunjungan}',
    [KunjunganController::class, 'show']
)
    ->middleware('auth')
    ->name('kunjungan.show');

// =========================
// ALIHKAN KUNJUNGAN
// Petugas piket dan penerima bidang
// =========================

Route::post(
    '/kunjungan/{kunjungan}/alihkan',
    [KunjunganController::class, 'alihkan']
)
    ->middleware([
        'auth',
        'role:petugas_piket,penerima_bidang',
    ])
    ->name('kunjungan.alihkan');

// =========================
// ADMIN
// =========================

Route::middleware([
    'auth',
    'role:admin',
])->group(function () {

    Route::get('/admin', [DashboardController::class, 'index'])
        ->name('admin.dashboard');

    // =========================
    // MANAJEMEN PENGGUNA
    // =========================

    Route::get(
        '/admin/users',
        [UserController::class, 'index']
    )->name('admin.users.index');

    Route::get(
        '/admin/users/create',
        [UserController::class, 'create']
    )->name('admin.users.create');

    Route::post(
        '/admin/users',
        [UserController::class, 'store']
    )->name('admin.users.store');

    Route::get(
        '/admin/users/{user}/edit',
        [UserController::class, 'edit']
    )->name('admin.users.edit');

    Route::put(
        '/admin/users/{user}',
        [UserController::class, 'update']
    )->name('admin.users.update');

    Route::patch(
        '/admin/users/{user}/toggle-aktif',
        [UserController::class, 'toggleAktif']
    )->name('admin.users.toggleAktif');

    Route::delete(
        '/admin/users/{user}',
        [UserController::class, 'destroy']
    )->name('admin.users.destroy');



    // =========================
    // DATA KUNJUNGAN ADMIN
    // =========================

    Route::get(
        '/admin/kunjungan',
        [AdminKunjunganController::class, 'index']
    )->name('admin.kunjungan.index');

    Route::get(
        '/admin/kunjungan/{kunjungan}',
        [AdminKunjunganController::class, 'show']
    )->name('admin.kunjungan.show');

    Route::get(
        '/admin/kunjungan/{kunjungan}/edit',
        [AdminKunjunganController::class, 'edit']
    )->name('admin.kunjungan.edit');

    Route::put(
        '/admin/kunjungan/{kunjungan}',
        [AdminKunjunganController::class, 'update']
    )->name('admin.kunjungan.update');

    // =========================
    // LAPORAN
    // =========================

    Route::get(
        '/admin/laporan',
        [LaporanController::class, 'index']
    )->name('admin.laporan.index');

    Route::get(
        '/admin/laporan/pdf',
        [LaporanController::class, 'pdf']
    )->name('admin.laporan.pdf');

    Route::get(
        '/admin/laporan/csv',
        [LaporanController::class, 'csv']
    )->name('admin.laporan.csv');

    // =========================
    // LOG AKTIVITAS
    // =========================

    Route::get(
        '/admin/log-aktivitas',
        [ActivityLogController::class, 'index']
    )->name('admin.activity_logs.index');

    Route::get(
        '/admin/log-aktivitas/latest',
        [ActivityLogController::class, 'latest']
    )->name('admin.activity_logs.latest');

    // =========================
    // MASTER BIDANG
    // =========================

    Route::get(
        '/admin/bidangs',
        [BidangController::class, 'index']
    )->name('admin.bidangs.index');

    Route::get(
        '/admin/bidangs/create',
        [BidangController::class, 'create']
    )->name('admin.bidangs.create');

    Route::post(
        '/admin/bidangs',
        [BidangController::class, 'store']
    )->name('admin.bidangs.store');

    Route::get(
        '/admin/bidangs/{bidang}/edit',
        [BidangController::class, 'edit']
    )->name('admin.bidangs.edit');

    Route::put(
        '/admin/bidangs/{bidang}',
        [BidangController::class, 'update']
    )->name('admin.bidangs.update');

    Route::patch(
        '/admin/bidangs/{bidang}/toggle-aktif',
        [BidangController::class, 'toggleAktif']
    )->name('admin.bidangs.toggleAktif');

});

// =========================
// PIMPINAN
// =========================

Route::middleware([
    'auth',
    'role:pimpinan',
])->group(function () {

    Route::get(
        '/pimpinan',
        [PimpinanController::class, 'index']
    )->name('pimpinan.dashboard');

    Route::get(
        '/pimpinan/laporan',
        [PimpinanController::class, 'laporan']
    )->name('pimpinan.laporan');

    Route::get(
        '/pimpinan/laporan/pdf',
        [PimpinanController::class, 'pdf']
    )->name('pimpinan.laporan.pdf');

    Route::get(
        '/pimpinan/laporan/csv',
        [PimpinanController::class, 'csv']
    )->name('pimpinan.laporan.csv');

});
